  "components": [
    {
      "name": "Primär-Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Hauptaktion: anrufen oder Besichtigung anfragen.",
      "html": "<button class=\"ds-btn ds-btn-primary\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"square\" aria-hidden=\"true\"><path d=\"M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 5a2 2 0 0 1 2-2\"/></svg>Jetzt anrufen</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;padding:14px 32px;border:0;border-radius:var(--radius-sm,4px);font:700 0.875rem/1.25 var(--font-sans,Inter,system-ui,sans-serif);letter-spacing:.5px;text-align:center;cursor:pointer;transition:transform 140ms cubic-bezier(.22,1,.36,1),background-color 180ms ease}.ds-btn:active{transform:scale(.97)}.ds-btn:focus-visible{outline:2px solid #1d1c1a;outline-offset:2px}.ds-btn-primary{background:#ffc000;color:#1d1c1a}.ds-btn-primary:hover{background:#e6ad00}"
    },
    {
      "name": "Sekundär-Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Zweite Aktion neben dem Primär-Button, auch auf Anthrazit.",
      "html": "<button class=\"ds-btn ds-btn-secondary\">Kostenlose Besichtigung anfragen</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;padding:14px 32px;border:0;border-radius:var(--radius-sm,4px);font:700 0.875rem/1.25 var(--font-sans,Inter,system-ui,sans-serif);letter-spacing:.5px;text-align:center;cursor:pointer;transition:transform 140ms cubic-bezier(.22,1,.36,1),background-color 180ms ease}.ds-btn:active{transform:scale(.97)}.ds-btn:focus-visible{outline:2px solid #1d1c1a;outline-offset:2px}.ds-btn-secondary{background:#fff;color:#1d1c1a}.ds-btn-secondary:hover{background:#e7e3da}"
    },
    {
      "name": "Karte",
      "kind": "card",
      "refersTo": "card",
      "description": "Weiße Karte mit gelber Oberkante für Leistungen, Vorteile und FAQ.",
      "html": "<article class=\"ds-card\"><h3>Entrümpelung</h3><p>Keller, Dachboden, Garage oder die ganze Wohnung: Wir räumen, trennen nach Wertstoffen und übergeben besenrein.</p></article>",
      "css": ".ds-card{position:relative;background:#fff;border:1px solid #e7e3da;border-top-color:#ffc000;border-radius:4px;padding:24px;color:#3a3834;font:300 1rem/1.55 Inter,system-ui,sans-serif;box-shadow:inset 0 3px 0 #ffc000,0 1px 2px rgb(29 28 26/.06),0 12px 32px -16px rgb(29 28 26/.28);transition:transform 240ms cubic-bezier(.22,1,.36,1),box-shadow 240ms cubic-bezier(.22,1,.36,1)}.ds-card:hover{transform:translateY(-3px);box-shadow:inset 0 3px 0 #ffc000,0 2px 4px rgb(29 28 26/.06),0 20px 40px -18px rgb(29 28 26/.35)}.ds-card h3{margin:0 0 8px;color:#1d1c1a;font:700 1.5rem/1.25 Inter,system-ui,sans-serif}.ds-card p{margin:0}"
    },
    {
      "name": "Karte dunkel",
      "kind": "card",
      "refersTo": "card-dark",
      "description": "Karte auf Anthrazit-Bändern (Vertrauen, Ablauf).",
      "html": "<div class=\"ds-card-dark\"><h3>Festpreis statt Überraschungen</h3><p>Nach der Besichtigung erhalten Sie einen verbindlichen Festpreis.</p></div>",
      "css": ".ds-card-dark{background:#2d2b28;border:1px solid #2d2b28;border-top-color:#ffc000;border-radius:4px;padding:24px;color:#fff;font:300 1rem/1.55 Inter,system-ui,sans-serif;box-shadow:inset 0 3px 0 #ffc000,0 12px 32px -16px rgb(0 0 0/.6)}.ds-card-dark h3{margin:0 0 4px;font:700 1.25rem/1.3 Inter,system-ui,sans-serif}.ds-card-dark p{margin:0}"
    },
    {
      "name": "Eingabefeld",
      "kind": "input",
      "refersTo": "input",
      "description": "Textfeld im Anfrageformular.",
      "html": "<label class=\"ds-field\">Name *<input class=\"ds-input\" placeholder=\"Ihr Name\"></label>",
      "css": ".ds-field{display:grid;gap:8px;color:#1d1c1a;font:700 1rem/1.4 Inter,system-ui,sans-serif}.ds-input{min-height:48px;padding:14px 16px;border:1px solid #6b675f;border-radius:4px;background:#fff;color:#1d1c1a;font:300 1rem/1.55 Inter,system-ui,sans-serif}.ds-input::placeholder{color:#6b675f}.ds-input:focus-visible{outline:2px solid #1d1c1a;outline-offset:2px}"
    },
    {
      "name": "Leistungs-Chip",
      "kind": "chip",
      "refersTo": "chip-service",
      "description": "Umschalter für Leistungen im Formular; gewählt in Gelb.",
      "html": "<span class=\"ds-chips\"><label class=\"ds-chip\"><input type=\"checkbox\" checked>Entrümpelung</label><label class=\"ds-chip\"><input type=\"checkbox\">Trockenbau</label></span>",
      "css": ".ds-chips{display:flex;gap:8px;flex-wrap:wrap}.ds-chip{display:inline-flex;align-items:center;min-height:44px;padding:0 16px;border:1px solid #6b675f;border-radius:4px;background:#fff;color:#1d1c1a;font:300 1rem/1.55 Inter,system-ui,sans-serif;cursor:pointer}.ds-chip input{position:absolute;opacity:0}.ds-chip:has(input:checked){background:#ffc000;border-color:#ffc000;font-weight:700}.ds-chip:has(input:focus-visible){outline:2px solid #1d1c1a;outline-offset:2px}"
    },
    {
      "name": "Navigation",
      "kind": "nav",
      "refersTo": "top-nav",
      "description": "Klebende Kopfzeile in Anthrazit mit Logo, Links und Anruf-Button.",
      "html": "<nav class=\"ds-nav\"><span class=\"ds-nav-brand\">J&amp;L Bauprojekte</span><a class=\"ds-nav-link\" aria-current=\"page\" href=\"#\">Leistungen</a><a class=\"ds-nav-link\" href=\"#\">Einsatzgebiet</a><a class=\"ds-nav-link\" href=\"#\">Kontakt</a><a class=\"ds-nav-cta\" href=\"#\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"square\" aria-hidden=\"true\"><path d=\"M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 5a2 2 0 0 1 2-2\"/></svg>Jetzt anrufen</a></nav>",
