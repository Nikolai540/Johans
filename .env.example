# Öffentliche URL der Website (für Canonical, Sitemap, Schema.org)
NEXT_PUBLIC_SITE_URL=https://jlbauprojekte.de

# Versand des Kontaktformulars über Resend (https://resend.com)
RESEND_API_KEY=
# Empfänger der Anfragen
CONTACT_TO_EMAIL=info@jlbauprojekte.de
# Absender (bei Resend verifizierte Domain)
CONTACT_FROM_EMAIL=Website J&L Bauprojekte <anfrage@jlbauprojekte.de>

# Google-Bewertungen auf der Startseite über die Places API (New). Ohne beide Werte entfällt der Abschnitt.
# Schlüssel in der Google Cloud Console auf "Places API (New)" beschränken, er wird nur auf dem Server genutzt.
GOOGLE_PLACES_API_KEY=
# Place ID des Google-Unternehmensprofils Landsberg am Lech (beginnt meist mit "ChIJ")
GOOGLE_PLACE_ID=
# Optional: Place ID des Profils Vilgertshofen für die Startseite /vilgertshofen/ (sonst gilt GOOGLE_PLACE_ID)
GOOGLE_PLACE_ID_VILGERTSHOFEN=
